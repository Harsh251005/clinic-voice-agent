# Dashboard sign-in with Google. Copy to .streamlit/secrets.toml (gitignored)
# and fill in; the README's Dashboard section explains each value.
[auth]
# Must end in /oauth2callback and match the redirect URI registered in Google.
redirect_uri = "http://localhost:8501/oauth2callback"
# Signs the login cookie. Generate: uv run python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = ""
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
