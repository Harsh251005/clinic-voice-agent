# ---------- Provider selection ----------
# Registry keys. Only the selected providers run, and only their keys are needed.
# Blank = sarvam, the production stack. Only these vendors are allowed:
#   STT: sarvam | elevenlabs
#   LLM: sarvam | openai
#   TTS: sarvam | elevenlabs
# Below is the current testing stack, chosen to save Sarvam credits.
STT_PROVIDER=elevenlabs
LLM_PROVIDER=openai
TTS_PROVIDER=elevenlabs

# ---------- API keys (only for the providers selected above) ----------
# https://dashboard.sarvam.ai — paid per use, shared across STT, LLM and TTS
SARVAM_API_KEY=
# https://platform.openai.com/api-keys — paid per use (prepaid credits)
OPENAI_API_KEY=
# https://elevenlabs.io/app/settings/api-keys — free tier has a monthly quota
ELEVENLABS_API_KEY=

# ---------- LiveKit ----------
# Not needed for `python main.py console`. Required for `dev` and `start`.
# https://cloud.livekit.io  (free tier: 1,000 agent-session minutes/month)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------- Speech to text ----------
# Leave blank for the selected provider's defaults:
#   sarvam:     model saaras:v4, language auto-detect ("unknown")
#   elevenlabs: model scribe_v2_realtime (its only streaming model; keep it),
#               language hi (blank or "unknown" = hi). Its auto-detect breaks on
#               live calls; pinned hi still hears English and Hinglish
STT_MODEL=
STT_LANGUAGE=
# Sarvam only: "transcribe" keeps the native script; "translit" romanises Hindi.
STT_MODE=transcribe
STT_SAMPLE_RATE=16000

# ---------- Language model ----------
# Leave blank for the selected provider's default:
#   openai  -> gpt-4.1-mini   (sarvam -> sarvam-105b-conversations)
LLM_MODEL=

# ---------- Text to speech ----------
# Leave blank for the selected provider's defaults. These values mean
# different things per provider — clear them when you switch TTS_PROVIDER.
#   elevenlabs: model eleven_v3_conversational (fallbacks: eleven_multilingual_v2,
#               eleven_flash_v2_5), speaker = a voice ID — pick a Hindi voice in
#               the Voice Library, the default is not one — codec pcm_24000,
#               language auto-detected (pin with an ISO code such as "hi")
#   sarvam:     model bulbul:v3, speaker suhani (any bulbul:v3 voice),
#               language en-IN, sample rate 24000, codec linear16
TTS_MODEL=
TTS_SPEAKER=
TTS_LANGUAGE=
TTS_SAMPLE_RATE=
TTS_CODEC=

# ---------- Clinic data ----------
# SQLite for development; postgresql+psycopg://user:pass@host:port/db for
# production, same code. After changing it: uv run python -m clinic_agent.store.migrations
DATABASE_URL=sqlite:///data/clinic.db

# ---------- Call links ----------
# Where the call-link server (uv run python -m api) is reachable by patients.
# Each clinic's link is <this>/call/<link name>. Locally: http://localhost:8080;
# for a demo from outside, your tunnel's https address.
PUBLIC_BASE_URL=http://localhost:8080
# Where the call-link server listens. 127.0.0.1 = only this machine (a tunnel
# or proxy forwards to it); 0.0.0.0 inside a container.
API_HOST=127.0.0.1
API_PORT=8080
# Behind a tunnel or proxy every request comes from 127.0.0.1, so per-caller
# rate limits need the real IP from a header: CF-Connecting-IP (Cloudflare
# Tunnel) or X-Forwarded-For (Caddy). Leave blank when patients connect directly.
CLIENT_IP_HEADER=

# ---------- Turn taking ----------
MIN_ENDPOINTING_DELAY=0.2

# ---------- Dashboard ----------
# "google": staff sign in with Google (see README). "off": no sign-in, everyone
# is an admin - local development only.
DASHBOARD_LOGIN=google
# Comma-separated. Admins see every clinic, create clinics and decide who may
# open each one. Everyone else sees only the clinics their email was added to.
ADMIN_EMAILS=
# Where staff open the dashboard (the Next.js app). Google's redirect URI must
# be this + /api/auth/callback.
DASHBOARD_URL=http://localhost:3000
# Signs the dashboard session cookie. Generate:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Google Cloud Console → Google Auth Platform → Clients (a Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Calls ----------
# Longest a call may last; then the receptionist says goodbye and hangs up.
# Stops a forgotten or abused call from spending minutes.
MAX_CALL_MINUTES=10
