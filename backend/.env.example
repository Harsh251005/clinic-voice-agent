# ---------- Required ----------
# Sarvam API key — powers STT, LLM and TTS. https://dashboard.sarvam.ai
SARVAM_API_KEY=

# ---------- LiveKit ----------
# Not needed for `python main.py console`. Required for `dev` and `start`.
# https://cloud.livekit.io  (free tier: 1,000 agent-session minutes/month)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------- Provider selection ----------
# Registry keys. Swapping a vendor is a change here plus one builder function.
STT_PROVIDER=sarvam
LLM_PROVIDER=sarvam
TTS_PROVIDER=sarvam

# ---------- Speech to text ----------
STT_MODEL=saaras:v4
# "unknown" auto-detects per utterance (Hindi / English / mixed).
STT_LANGUAGE=unknown
# "transcribe" keeps the native script; "translit" romanises Hindi. Switch to
# translit if Hindi replies come out mispronounced.
STT_MODE=transcribe
STT_SAMPLE_RATE=16000

# ---------- Language model ----------
# sarvam-105b-conversations | sarvam-105b | gemma4 | glm5.2
LLM_MODEL=sarvam-105b-conversations

# ---------- Text to speech ----------
TTS_MODEL=bulbul:v3
# bulbul:v3 female: anushka, suhani, priya, neha, shruti, kavya ...
# bulbul:v3 male:   shubh, aditya, rohan, kabir, varun ...
TTS_SPEAKER=anushka
TTS_LANGUAGE=en-IN
TTS_SAMPLE_RATE=24000
# linear16 avoids an mp3 decode on every chunk.
TTS_CODEC=linear16

# ---------- Turn taking ----------
MIN_ENDPOINTING_DELAY=0.2
