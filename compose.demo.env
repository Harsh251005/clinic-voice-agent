# Placeholders for `docker compose up`, so the dashboard starts with no keys
# at all. Calls need real LiveKit and vendor keys: put them in backend/.env,
# which overrides these. Nothing secret belongs in this file.
LIVEKIT_URL=wss://set-your-project.livekit.cloud
LIVEKIT_API_KEY=placeholder
LIVEKIT_API_SECRET=placeholder-secret-set-a-real-one-in-backend-env
